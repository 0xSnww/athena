{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/dev/blueprint-web-apple-touch-180.png",
  "scripts": [
    {
      "name": "Dev",
      "command": "vp run dev",
      "icon": "play",
      "stopOnSettle": true
    },
    {
      "name": "Dev Desktop",
      "command": "vp run dev:desktop",
      "icon": "play",
      "stopOnSettle": true
    },
    {
      "name": "Check Changed",
      "command": "vp run check:changed",
      "icon": "test"
    },
    {
      "name": "Typecheck",
      "command": "vp run typecheck",
      "icon": "lint"
    },
    {
      "name": "Doctor",
      "command": "vp run doctor",
      "icon": "configure"
    },
    {
      "name": "Setup Worktree",
      "command": "node scripts/setup-worktree.ts",
      "icon": "configure",
      "runOnWorktreeCreate": true
    }
  ]
}
